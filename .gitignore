.DS_Store
Thumbs.db
node_modules/
*.log

# npm writes this the first time any npm command runs. The project has no
# dependencies, so it locks nothing and only invites someone to believe there is
# an install step.
package-lock.json

# SQLite database and its write-ahead log
data/
*.db
*.db-wal
*.db-shm

# Local snapshots. These bundle data/ — which means the live database and every
# uploaded attachment — so they must never be committed.
*.zip
*.tar.gz
*.tgz

# Android build output, and the file Android Studio writes pointing at whichever
# SDK happens to be installed on this machine.
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Signing keys. Losing one means never being able to update an installed app;
# committing one means anyone can publish as you.
*.jks
*.keystore
